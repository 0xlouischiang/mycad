{
  "name": "mycad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:solver": "node --experimental-strip-types src/sketch/solver.test.ts",
    "test:profile": "node --experimental-strip-types src/sketch/profile.test.ts",
    "test:regen": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/kernel/regen.test.ts",
    "test:robot": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/model/robot.test.ts",
    "test:commands": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/commands/registry.test.ts",
    "test:chat": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/commands/chatController.test.ts",
    "test:proxy": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs api/chat.test.ts",
    "test:bim": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/model/bim.test.ts",
    "test:bimgeom": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/bim/geometry.test.ts",
    "test:wallcut": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/bim/wallCut.test.ts",
    "test:cascade": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/bim/cascade.test.ts",
    "test:ifc": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/bim/ifc.test.ts",
    "test:bimchat": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/commands/bimRegistry.test.ts",
    "test:cfd": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/model/cfd.test.ts",
    "test:cfdcase": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/cfd/namedStl.test.ts && node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/cfd/zip.test.ts && node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/cfd/caseGen.test.ts && node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/cfd/residuals.test.ts",
    "test:cfdchat": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/commands/cfdRegistry.test.ts",
    "test:cfdapi": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs api/cfd.test.ts",
    "test:cfdof": "node --experimental-strip-types --import ./src/test/ts-resolve.mjs src/cfd/openfoam.integration.test.ts",
    "test": "npm run test:solver && npm run test:profile && npm run test:regen && npm run test:robot && npm run test:commands && npm run test:chat && npm run test:proxy && npm run test:bim && npm run test:bimgeom && npm run test:wallcut && npm run test:cascade && npm run test:ifc && npm run test:bimchat && npm run test:cfd && npm run test:cfdcase && npm run test:cfdchat && npm run test:cfdapi"
  },
  "dependencies": {
    "occt-wasm": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0",
    "web-ifc": "^0.0.77",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
