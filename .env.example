# Claude API key for the chat-driven modeling proxy (Phase 13).
# The key stays server-side (Vite dev middleware / serverless function); the
# browser never sees it. Chat degrades gracefully if this is unset.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the proxy.
# CLAUDE_MODEL=claude-sonnet-5

# OpenFOAM.org v11 Docker image for in-app CFD solves (optional).
# If Docker isn't running, Download case (.zip) still works.
# OPENFOAM_IMAGE=openfoam/openfoam11-paraviewopenfoam
# OPENFOAM_TEST_IMAGE=openfoam/openfoam11-paraviewopenfoam
